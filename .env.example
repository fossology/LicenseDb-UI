# Vite build configuration
VITE_BASE_URL=/api/v1
VITE_DOMAIN_SUBDIRECTORY=

# Full-stack Docker Compose configuration
# The backend repository must be checked out next to this repository.
LICENSEDB_BACKEND_CONTEXT=../LicenseDb
LICENSEDB_UI_PORT=8081

POSTGRES_USER=fossy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fossology
POPULATE_DB=true
GIN_MODE=debug
